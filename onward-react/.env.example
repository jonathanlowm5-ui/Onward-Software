# Base URL for the shared Onward API (admin + frontend use the same layer).
# In dev, Vite proxies /api to VITE_API_PROXY (see vite.config.js).
VITE_API_BASE=/api
VITE_API_PROXY=http://localhost:4000

# Firebase (customer auth). Unused by default — player auth runs on the backend
# JWT API — but kept in sync with the live project for optional client SDK use.

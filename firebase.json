{
  "functions": [
    {
      "source": "onward-integration/backend",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "data",
        "uploads",
        "*.log",
        ".env",
        ".env.*"
      ]
    }
  ],
  "firestore": {
    "database": "onward",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "frontend",
      "public": "onward-react/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
        { "source": "/@(sw|service-worker|serviceWorker|firebase-messaging-sw|pwa-sw).js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
        { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
        { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] }
      ],
      "rewrites": [
        { "source": "/api/**", "function": { "functionId": "api", "region": "us-central1" } },
        { "source": "/uploads/**", "function": { "functionId": "api", "region": "us-central1" } },
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "admin",
      "public": "onward-admin/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
        { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
        { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] }
      ],
      "rewrites": [
        { "source": "/api/**", "function": { "functionId": "api", "region": "us-central1" } },
        { "source": "/uploads/**", "function": { "functionId": "api", "region": "us-central1" } },
        { "source": "**", "destination": "/index.html" }
      ]
    }
  ]
}

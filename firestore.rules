rules_version = '2';

// All Onward data is accessed exclusively through the backend API (Cloud
// Functions) using the Admin SDK, which bypasses these rules. No browser ever
// talks to Firestore directly, so we deny all direct client access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
